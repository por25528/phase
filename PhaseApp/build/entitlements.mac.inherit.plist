<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Signed onto the Electron helper bundles (Renderer, GPU, Plugin). They
         must carry the same hardened-runtime exceptions as the main app or the
         renderer will be killed the moment V8 allocates executable memory.
         com.apple.security.inherit is deliberately absent: it is a sandbox key,
         and Phase is a Developer ID app with no sandbox to inherit. -->

    <!-- V8 compiles JavaScript at runtime; without these two the renderer dies
         on launch. https://github.com/electron/notarize#prerequisites -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Electron launches its helpers through DYLD_* variables, and
         ELECTRON_RUN_AS_NODE relies on the same mechanism. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- The framework and the helper bundles are signed as separate code, and
         library validation would refuse to load them into the main app.
         https://github.com/electron-userland/electron-builder/issues/3940 -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
